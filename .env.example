# Salin file ini jadi .env lalu isi nilainya. .env TIDAK di-commit.

# --- LLM (API kompatibel OpenAI; default DeepSeek langsung) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Alternatif OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=deepseek/deepseek-v4-flash

# --- LLM cadangan (opsional, dipakai kalau LLM utama gagal/rate limit) ---
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=

# --- Rerank pencarian DarGlobal (TypeSafe / Jev); kosong = tanpa rerank ---
TYPESAFE_API_KEY=

# --- Tracing (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=darglobal-chatbot
# Isi kalau akun LangSmith BUKAN region US, misal: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# --- Database (memori chat / checkpointer) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
# Lokal (Postgres dari docker compose, port di-expose ke host):
CHECKPOINT_DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# --- Rate limit (batasi biaya LLM; hitungan di memori, per proses) ---
# Per IP: "jumlah/detik" (default 20 pesan / 10 menit); "0" = mati
RATE_LIMIT_PER_IP=20/600
# Semua user per 24 jam (pagar biaya kalau URL disebar); 0 = mati
RATE_LIMIT_GLOBAL_PER_DAY=1000
# true HANYA kalau app di belakang proxy/tunnel (IP dibaca dari CF-Connecting-IP / X-Forwarded-For)
TRUST_PROXY_HEADERS=false
